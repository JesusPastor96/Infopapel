---
// src/pages/index.astro
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import LayerDeconstruct from '../components/LayerDeconstruct.astro';
import StoryScroll from '../components/StoryScroll.astro';
import BentoGrid from '../components/BentoGrid.astro';
import TributeSection from '../components/TributeSection.astro';
import ContactDirect from '../components/ContactDirect.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}vitruvio-red.png`} />
    <title>Infopapel | Papelería, Informática & Equipamiento</title>
    <meta 
      name="description" 
      content="Infopapel: Papelería, informática, impresión y mobiliario de oficina. Más de dos décadas mirando por el cliente. El servicio como piedra angular." 
    />
  </head>
  <body>
    <!-- Modern Groundbreaking Dock & Top Mark -->
    <Navbar />

    <!-- Main Sections -->
    <main>
      <Hero />
      <LayerDeconstruct />
      <StoryScroll />
      <BentoGrid />
      <ContactDirect />
      <TributeSection />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- GSAP & Lenis Smooth Scroll Script -->
    <script>
      import Lenis from 'lenis';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      // 1. Initialize Lenis for natural inertia smooth scrolling
      const lenis = new Lenis({
        duration: 1.3,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        orientation: 'vertical',
        smoothWheel: true,
      });

      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });
      gsap.ticker.lagSmoothing(0);

      // 2. Intercept ALL internal anchor clicks for buttery smooth scrolling
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener('click', (e) => {
          const href = anchor.getAttribute('href');
          if (!href || href === '#') return;
          
          const target = document.querySelector(href);
          if (target) {
            e.preventDefault();
            lenis.scrollTo(target as HTMLElement, {
              offset: -30,
              duration: 1.3,
              easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            });
          }
        });
      });

      // 3. Back to top arrow handler
      const backBtn = document.getElementById('backToTopBtn');
      if (backBtn) {
        backBtn.addEventListener('click', () => {
          lenis.scrollTo(0, {
            duration: 1.4,
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          });
        });
      }

      // 4. Hero entrance animations
      const heroTimeline = gsap.timeline({ defaults: { ease: 'power2.out' } });

      heroTimeline
        .from('[data-hero-elem]', {
          y: 28,
          opacity: 0,
          duration: 0.8,
          stagger: 0.1,
          delay: 0.1
        })
        .from('.vitruvio-graphic', {
          scale: 0.9,
          opacity: 0,
          duration: 1,
          ease: 'power2.out'
        }, '-=0.5');



      // 6. Staggered reveal for Story and Services
      gsap.from('[data-story-col]', {
        scrollTrigger: {
          trigger: '.story-columns',
          start: 'top 80%',
          toggleActions: 'play none none none',
        },
        y: 35,
        opacity: 0,
        duration: 0.7,
        stagger: 0.12,
        ease: 'power2.out'
      });

      gsap.from('[data-service-card]', {
        scrollTrigger: {
          trigger: '.services-layout',
          start: 'top 80%',
          toggleActions: 'play none none none',
        },
        y: 35,
        opacity: 0,
        duration: 0.7,
        stagger: 0.1,
        ease: 'power2.out'
      });
    </script>
  </body>
</html>
