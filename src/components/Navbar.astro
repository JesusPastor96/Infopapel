---
// src/components/Navbar.astro
---

<!-- Modern Floating Top Pill Navigation -->
<header class="floating-header" aria-label="Cabecera principal">
  <div class="nav-pill-container">
    
    <!-- Brand Logo & Name -->
    <a href="#hero" class="brand-link" data-scroll-to="#hero" title="Ir al inicio">
      <img src={`${import.meta.env.BASE_URL}vitruvio-red.png`} alt="Hombre de Vitruvio" class="brand-emblem" />
      <span class="brand-name font-serif">Infopapel</span>
    </a>

    <!-- Center Navigation Links -->
    <nav class="nav-links">
      <a href="#capas" class="nav-link" data-scroll-to="#capas">Capas</a>
      <a href="#historia" class="nav-link" data-scroll-to="#historia">Historia</a>
      <a href="#servicios" class="nav-link" data-scroll-to="#servicios">Servicios</a>
      <a href="#contacto" class="nav-link" data-scroll-to="#contacto">Contacto</a>
      <a href="#manifiesto" class="nav-link" data-scroll-to="#manifiesto">Homenaje</a>
    </nav>

    <!-- Right Controls: Theme Toggle & WhatsApp -->
    <div class="nav-controls">
      <!-- Theme Switcher (Light / Dark) -->
      <button id="themeToggleBtn" class="theme-btn" type="button" aria-label="Cambiar tema claro / oscuro" title="Cambiar tema">
        <!-- Sun Icon (shown in dark mode) -->
        <svg class="sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
        </svg>
        <!-- Moon Icon (shown in light mode) -->
        <svg class="moon-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <!-- WhatsApp Direct CTA -->
      <a 
        href="https://wa.me/?text=Hola%20Infopapel,%20os%20escribo%20desde%20la%20web" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="nav-cta-btn"
        title="Escribir por WhatsApp"
      >
        <span>WhatsApp</span>
      </a>
    </div>

  </div>
</header>

<!-- Floating Back to Top Arrow Button -->
<button id="backToTopBtn" class="back-to-top" type="button" aria-label="Subir arriba" title="Subir arriba">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 19V5M5 12l7-7 7 7"/>
  </svg>
</button>

<style>
  /* Fixed Centered Top Floating Pill */
  .floating-header {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    width: auto;
    max-width: 92vw;
  }

  .nav-pill-container {
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 7px 10px 7px 16px;
    background-color: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 9999px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08); /* taste-skill-ignore */
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }

  /* Brand */
  .brand-link {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink-primary);
  }

  .brand-emblem {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }

  .brand-name {
    font-size: 1.35rem;
    line-height: 1;
    font-weight: 400;
  }

  /* Center Links */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .nav-link {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ink-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
    padding: 4px 2px;
  }

  .nav-link:hover {
    color: var(--ink-primary);
  }

  /* Right Controls */
  .nav-controls {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .theme-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background-color: var(--bg-surface);
    color: var(--ink-primary);
    border: none;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .theme-btn:hover {
    background-color: var(--bg-surface-alt);
  }

  .nav-cta-btn {
    display: inline-flex;
    align-items: center;
    padding: 7px 15px;
    background-color: var(--red-accent);
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 9999px;
    transition: background-color 0.15s ease;
  }

  .nav-cta-btn:hover {
    background-color: var(--red-accent-hover);
  }

  /* Floating Back to Top Button */
  .back-to-top {
    position: fixed;
    bottom: 28px;
    right: 32px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: var(--bg-card);
    border: 1px solid var(--border-subtle);
    color: var(--ink-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08); /* taste-skill-ignore */
    cursor: pointer;
    z-index: 95;
    opacity: 0;
    pointer-events: none;
    transform: translateY(10px);
    transition: opacity 0.3s ease, transform 0.3s ease, background-color 0.2s ease;
  }

  .back-to-top.visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .back-to-top:hover {
    background-color: var(--ink-primary);
    color: var(--bg-ground);
  }

  /* Theme toggle icon switching */
  :global([data-theme="dark"]) .moon-icon {
    display: none;
  }
  :global([data-theme="dark"]) .sun-icon {
    display: block;
  }
  :global(:not([data-theme="dark"])) .sun-icon {
    display: none;
  }
  :global(:not([data-theme="dark"])) .moon-icon {
    display: block;
  }

  @media (max-width: 820px) {
    .nav-links {
      display: none;
    }
    .nav-pill-container {
      gap: 16px;
      padding: 6px 8px 6px 14px;
    }
    .back-to-top {
      right: 16px;
      bottom: 20px;
    }
  }
</style>

<script>
  // Theme Toggle Logic
  const themeBtn = document.getElementById('themeToggleBtn');
  const savedTheme = localStorage.getItem('infopapel-theme');
  if (savedTheme === 'dark') {
    document.documentElement.setAttribute('data-theme', 'dark');
  } else {
    document.documentElement.removeAttribute('data-theme');
  }

  if (themeBtn) {
    themeBtn.addEventListener('click', () => {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      if (isDark) {
        document.documentElement.removeAttribute('data-theme');
        localStorage.setItem('infopapel-theme', 'light');
      } else {
        document.documentElement.setAttribute('data-theme', 'dark');
        localStorage.setItem('infopapel-theme', 'dark');
      }
    });
  }

  // Back to Top Button Visibility
  const backBtn = document.getElementById('backToTopBtn');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 300) {
      backBtn?.classList.add('visible');
    } else {
      backBtn?.classList.remove('visible');
    }
  }, { passive: true });
</script>
