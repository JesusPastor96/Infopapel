---
// src/components/Footer.astro
---

<footer class="site-footer">
  <div class="container-editorial">
    
    <div class="footer-top">
      <div class="footer-intro">
        <div class="footer-brand">
          <img src={`${import.meta.env.BASE_URL}vitruvio-red.png`} alt="Hombre de Vitruvio" class="footer-mark" />
          <span class="footer-name font-serif">Infopapel</span>
        </div>
        <p class="footer-summary text-muted">
          Papelería de toda la vida, informática y equipamiento de proximidad. 
          Más de dos décadas cuidando de los proyectos, las herramientas y las necesidades de nuestros clientes.
        </p>
      </div>

      <nav class="footer-nav">
        <span class="footer-nav-title">Navegación</span>
        <a href="#hero">Inicio</a>
        <a href="#capas">Desglose 3D</a>
        <a href="#historia">Nuestra Historia</a>
        <a href="#servicios">Servicios</a>
        <a href="#contacto">Contacto</a>
        <a href="#manifiesto">Homenaje</a>
      </nav>
    </div>

    <div class="footer-bottom text-muted">
      <span>© {new Date().getFullYear()} Infopapel. Todos los derechos reservados.</span>
      <span class="footer-dedication text-red">Creado con orgullo para mi padre · Tu hijo</span>
    </div>

  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    padding: 80px 0 40px;
    background-color: var(--bg-ground);
    transition: background-color 0.25s ease;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    gap: 60px;
    padding-bottom: 50px;
  }

  .footer-intro {
    max-width: 440px;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .footer-mark {
    width: 28px;
    height: 28px;
    object-fit: contain;
  }

  .footer-name {
    font-size: 1.5rem;
    line-height: 1;
    color: var(--ink-primary);
  }

  .footer-summary {
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-nav-title {
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-primary);
    margin-bottom: 4px;
  }

  .footer-nav a {
    font-size: 0.9rem;
    color: var(--ink-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-nav a:hover {
    color: var(--ink-primary);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 30px;
    font-size: 0.85rem;
    flex-wrap: wrap;
    gap: 16px;
  }

  .footer-dedication {
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .footer-top {
      flex-direction: column;
    }
  }
</style>
